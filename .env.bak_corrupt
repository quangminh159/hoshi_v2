# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://hoshi:hoshipassword@127.0.0.1:5432/hoshi

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Social Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
APPLE_KEY_ID=your-apple-key-id
APPLE_CERTIFICATE_KEY=your-apple-certificate-key

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=your-email@domain.com

# Twilio SMS (OTP d?t l?i m?t kh?u / d?i SÐT)
# L?y t?i https://console.twilio.com/ — di?n giá tr? th?t r?i restart runserver
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# reCAPTCHA
RECAPTCHA_PUBLIC_KEY=your-public-key
RECAPTCHA_PRIVATE_KEY=your-private-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=1

# Other Settings
DEFAULT_FROM_EMAIL=noreply@hoshi.vn
SITE_NAME=Hoshi
SITE_URL=https://hoshi.vn
ADMIN_URL=admin/
MAINTENANCE_MODE=False
TIME_ZONE=Asia/Ho_Chi_Minh
LANGUAGE_CODE=vi

# --- Launch hardening ---
# Alias c?a DJANGO_SECRET_KEY — production ph?i d?i
SECRET_KEY=change-me-generate-a-long-random-string
# local: True | production: False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Gi?i h?n upload (MB)
MAX_UPLOAD_MB=50
# Sentry DSN (d? tr?ng = t?t)
SENTRY_DSN=
INVITE_ONLY=False
# production beta: INVITE_ONLY=True

# WebRTC TURN (g?i qua ngrok/4G)



TURN_URLS=turn:staticauth.openrelay.metered.ca:80,turn:staticauth.openrelay.metered.ca:443,turns:staticauth.openrelay.metered.ca:443,turn:staticauth.openrelay.metered.ca:443?transport=tcp
TURN_SECRET=openrelayprojectsecret
WEBRTC_ICE_TRANSPORT_POLICY=relay
WEBRTC_PREFER_RELAY=True
