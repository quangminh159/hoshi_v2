# =============================================================================
# Moora — .env (server bạn / production)
# Copy thành .env trên server. Đổi YOUR_DOMAIN hoặc dùng IP.
# =============================================================================

DEBUG=False
SECRET_KEY=REPLACE_ME

ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=http://YOUR_DOMAIN:8000,https://YOUR_DOMAIN

# Docker compose tự nối db/redis; nếu chạy tay thì sửa HOST
DATABASE_URL=postgres://hoshi:hoshipassword@db:5432/hoshi
REDIS_URL=redis://redis:6379/0

# --- Bảo mật tin nhắn (mã hóa khi lưu DB) ---
MESSAGE_ENCRYPTION_ENABLED=True
# Tạo key: python manage.py generate_message_encryption_key
MESSAGE_ENCRYPTION_KEY=

# --- Web Push (thông báo ĐT) ---
# Tạo: python manage.py generate_vapid_keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_ADMIN_EMAIL=mailto:admin@YOUR_DOMAIN

INVITE_ONLY=True
MAX_UPLOAD_MB=50

# --- Media local (chạy thử trên server bạn) ---
# Để trống AWS_* + ALLOW_LOCAL_MEDIA=True → lưu volume Docker /app/media
ALLOW_LOCAL_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# --- Email (tùy, làm sau) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Moora <noreply@YOUR_DOMAIN>
SITE_NAME=Moora

# --- OAuth (làm sau) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- TURN (làm sau nếu cần gọi khác mạng) ---
TURN_EXTERNAL_IP=
TURN_HOST=
TURN_USERNAME=moora
TURN_CREDENTIAL=
WEBRTC_ICE_TRANSPORT_POLICY=all
WEBRTC_PREFER_RELAY=False

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
